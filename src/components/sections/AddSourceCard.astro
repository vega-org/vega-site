---
import { Check, Copy, Monitor, Smartphone } from "@lucide/astro";
import { APP_LINKS, MAINTAINER } from "../../config/site";

const sourceUrl = APP_LINKS.zendaXRepo;
const sourceName = "Zenda-X";
const encodedUrl = encodeURIComponent(sourceUrl);
const desktopUri = `vega://add-source?url=${encodedUrl}`;
const androidIntent = `intent:#Intent;action=vega.intent.action.ADD_SOURCE;package=com.vega;S.url=${encodedUrl};end`;

const buttonBase =
  "inline-flex items-center justify-center gap-2.5 rounded-lg px-5 py-3.5 font-headline text-[15px] font-bold transition";
const steps = [
  "Open Vega on your phone, TV or computer.",
  "Go to Settings > Provider Manager > Available Providers.",
  "Tap the + button.",
  "Enter zenda-cross or paste the repository URL, then confirm.",
];
---

<div class="mx-auto w-full max-w-xl">
  <p
    class="font-headline text-xs font-bold uppercase tracking-[0.14em] text-vega-accent"
  >
    Provider source
  </p>
  <h1
    class="mt-3 font-headline text-[clamp(2rem,5vw,2.75rem)] leading-[1.05] font-black tracking-tight text-white"
  >
    Add {sourceName} to Vega
  </h1>
  <p class="mt-3 leading-relaxed text-vega-muted">
    This adds the {sourceName} provider source to Vega. Vega should open on its own.
    If it doesn't, use one of the buttons below.
  </p>

  <p id="launch-status" class="mt-6 text-sm text-vega-muted" aria-live="polite">
    Opening Vega…
  </p>

  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <a
      id="android-trigger-btn"
      href={androidIntent}
      data-platform="android"
      class={`${buttonBase} border border-white/15 bg-white/5 text-white hover:bg-white/10`}
    >
      <Smartphone class="h-5 w-5 shrink-0" aria-hidden="true" />
      Click to add on Android
    </a>
    <a
      id="desktop-trigger-btn"
      href={desktopUri}
      data-platform="desktop"
      class={`${buttonBase} border border-white/15 bg-white/5 text-white hover:bg-white/10`}
    >
      <Monitor class="h-5 w-5 shrink-0" aria-hidden="true" />
      Click to add on Desktop
    </a>
  </div>

  <div
    class="mt-8 flex items-center gap-3 rounded-xl border border-white/10 bg-vega-surface px-4 py-3.5"
  >
    <img
      class="h-9 w-9 shrink-0 rounded-full object-cover"
      src={MAINTAINER.avatarUrl}
      alt=""
      width="36"
      height="36"
      loading="lazy"
    />
    <div class="min-w-0 flex-1">
      <div class="truncate font-headline text-sm font-bold text-white">
        Zenda-Cross/vega-providers
      </div>
      <div class="truncate text-xs text-vega-muted">{sourceUrl}</div>
    </div>
    <button
      type="button"
      id="copy-source-btn"
      data-copy-url={sourceUrl}
      class="inline-flex shrink-0 items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-bold text-vega-muted transition hover:bg-white/10 hover:text-white"
      aria-label="Copy repository URL"
    >
      <Copy class="h-4 w-4" id="copy-icon" aria-hidden="true" />
      <Check
        class="hidden h-4 w-4 text-emerald-400"
        id="copied-icon"
        aria-hidden="true"
      />
      <span id="copy-text">Copy</span>
    </button>
  </div>

  <section class="mt-10">
    <h2 class="font-headline text-lg font-bold text-white">Add it yourself</h2>
    <ol class="mt-4 space-y-3">
      {
        steps.map((step, index) => (
          <li class="flex gap-3 text-sm leading-relaxed text-vega-muted">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/8 font-headline text-xs font-bold text-white">
              {index + 1}
            </span>
            <span class="pt-0.5">{step}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <p class="mt-10 border-t border-white/10 pt-6 text-sm text-vega-muted">
    Don't have Vega yet?
    <a
      href="/#download"
      class="font-bold text-vega-accent underline-offset-4 hover:underline"
      >Download it</a
    >.
  </p>
</div>

<script is:inline>
  (() => {
    const isAndroid = /Android/i.test(navigator.userAgent);
    const primary = document.getElementById(
      isAndroid ? "android-trigger-btn" : "desktop-trigger-btn",
    );
    const status = document.getElementById("launch-status");

    if (primary) {
      // Open Vega once on load.
      try {
        window.location.href = primary.getAttribute("href");
      } catch {
        // The buttons stay available.
      }
    }

    setTimeout(() => {
      if (status) {
        status.textContent = isAndroid
          ? "Vega didn't open? Tap Open on Android."
          : "Vega didn't open? Click Open on Desktop.";
      }
    }, 1500);

    const copyBtn = document.getElementById("copy-source-btn");
    const copyIcon = document.getElementById("copy-icon");
    const copiedIcon = document.getElementById("copied-icon");
    const copyText = document.getElementById("copy-text");

    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.copyUrl || "");
        copyIcon?.classList.add("hidden");
        copiedIcon?.classList.remove("hidden");
        if (copyText) copyText.textContent = "Copied";
      } catch {
        if (copyText) copyText.textContent = "Copy failed";
      }
      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        copiedIcon?.classList.add("hidden");
        if (copyText) copyText.textContent = "Copy";
      }, 2000);
    });
  })();
</script>
