---
import { ExternalLink, FolderSync, Monitor, Smartphone } from "@lucide/astro";

const syncthingUrl = "https://syncthing.net/";
---

<section
  id="cross-device-sync"
  class="rounded-2xl border border-white/10 bg-vega-surface p-7 md:p-10"
>
  <div
    class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-vega-accent"
  >
    <FolderSync class="h-4 w-4" aria-hidden="true" />
    Cross-Device Sync
  </div>

  <h2
    class="mt-4 font-headline text-[clamp(1.8rem,3.6vw,2.6rem)] font-black tracking-tight text-white"
  >
    Sync Vega Between Android and Desktop
  </h2>

  <p class="mt-3 max-w-[72ch] text-base leading-relaxed text-vega-muted">
    Set a download folder in both Vega apps, then use Syncthing to keep those
    folders synchronized.
  </p>

  <div class="mt-6 space-y-4">
    <article class="rounded-xl border border-white/10 bg-vega-surface-hi p-5">
      <div class="inline-flex items-center gap-2 text-white">
        <Smartphone class="h-4 w-4 text-vega-accent" aria-hidden="true" />
        <h3 class="font-headline text-lg font-bold">
          1. Set the Android Download Folder
        </h3>
      </div>
      <ol
        class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-vega-muted marker:text-vega-accent"
      >
        <li>Open Vega on Android.</li>
        <li>Go to <strong class="text-white">Settings</strong>.</li>
        <li>
          Under Downloads, open <strong class="text-white"
            >Download Location</strong
          >.
        </li>
        <li>Select a folder and allow access when Android asks.</li>
      </ol>
    </article>

    <article class="rounded-xl border border-white/10 bg-vega-surface-hi p-5">
      <div class="inline-flex items-center gap-2 text-white">
        <Monitor class="h-4 w-4 text-vega-accent" aria-hidden="true" />
        <h3 class="font-headline text-lg font-bold">
          2. Set the Desktop Download Folder
        </h3>
      </div>
      <ol
        class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-vega-muted marker:text-vega-accent"
      >
        <li>Open Vega on Desktop.</li>
        <li>Go to <strong class="text-white">Settings</strong>.</li>
        <li>
          Under <strong class="text-white">Download Directory</strong>, select a
          folder for Vega downloads.
        </li>
      </ol>
    </article>

    <article
      class="rounded-xl border border-vega-accent/30 bg-vega-surface-hi p-5"
    >
      <div class="inline-flex items-center gap-2 text-white">
        <FolderSync class="h-4 w-4 text-vega-accent" aria-hidden="true" />
        <h3 class="font-headline text-lg font-bold">
          3. Sync Both Folders with Syncthing
        </h3>
      </div>
      <ol
        class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-vega-muted marker:text-vega-accent"
      >
        <li>Install Syncthing on Android and Desktop.</li>
        <li>Connect both devices in Syncthing.</li>
        <li>Add the Android Vega download folder to Syncthing.</li>
        <li>
          Share it with Desktop and select the Desktop Vega download folder as
          its local folder.
        </li>
        <li>Wait until Syncthing shows both devices as up to date.</li>
      </ol>
      <a
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-vega-accent px-4 py-2 text-sm font-bold text-[#240900] transition hover:-translate-y-0.5"
        href={syncthingUrl}
        target="_blank"
        rel="noreferrer"
      >
        <ExternalLink class="h-4 w-4" aria-hidden="true" />
        Visit Syncthing
      </a>
    </article>
  </div>

  <div class="mt-6 rounded-lg border border-white/10 bg-black/20 p-4">
    <p class="text-sm leading-relaxed text-vega-muted">
      Keep Syncthing running until both folders are up to date, then open Vega
      to see synchronized downloads, WatchList changes, and playback progress.
    </p>
  </div>
</section>
