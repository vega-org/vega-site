{
  "name": "vega-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:cast && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "build:cast": "npm run build:site --workspace @vega/web-cast",
    "test:cast": "npm test --workspace @vega/web-cast",
    "test:cast:cloudflare": "node --test tests/cast-cloudflare.test.mjs",
    "dev:cast": "npm run dev --workspace @vega/web-cast",
    "test:cast:browser": "npm run test:browser --workspace @vega/web-cast",
    "cast:server": "npm run cast:server --workspace @vega/web-cast"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.7.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.3",
    "marked": "^17.0.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "vite": "^7"
  },
  "workspaces": [
    "packages/web-cast"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0"
  }
}
