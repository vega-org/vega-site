---
import { Star } from "@lucide/astro";
import { Image } from "astro:assets";
import { REPO } from "../../config/site";
import heroLandscape from "../../assets/hero-landscape.png";
import heroPortrait from "../../assets/hero-portrait.jpg";
---

<header
  class="hero-section overflow-hidden px-4 pb-6 pt-28 md:px-6 md:pb-10 md:pt-28 lg:pb-8 lg:pt-24"
  id="top"
>
  <div
    class="mx-auto grid w-full max-w-350 items-center gap-8 lg:min-h-[calc(100svh-4.5rem)] lg:grid-cols-[1.03fr_0.97fr]"
  >
    <div>
      <!-- <span
        class="inline-block rounded-md bg-vega-surface-hi px-3 py-1 pt-1.5 font-headline text-xs font-bold uppercase tracking-[0.12em] text-vega-accent"
        >Open Source</span
      > -->
      <h1
        class="mt-3 font-headline text-[clamp(2.05rem,8.7vw,5.2rem)] leading-[0.94] font-black tracking-tight text-white"
      >
        Play, stream and cast your media.
      </h1>
      <p
        class="mt-4 max-w-[38ch] text-[clamp(1rem,1.6vw,1.15rem)] leading-relaxed text-vega-muted"
      >
        Vega is an open-source app for playing, streaming and casting remote
        and local media. Create custom plugins and keep your privacy.
      </p>
      <div class="mt-5 flex flex-wrap gap-3 max-md:*:w-full">
        <a
          class="inline-flex items-center justify-center rounded-md bg-linear-to-br from-vega-accent to-vega-accent-strong px-7 py-3.5 font-headline text-base font-extrabold text-[#240900] transition hover:-translate-y-0.5 hover:shadow-[0_14px_28px_rgba(255,120,82,0.35)]"
          href="#download"
        >
          Download Vega
        </a>
        <a
          class="inline-flex items-center justify-center gap-2 rounded-md border border-white/15 bg-white/5 px-7 py-3.5 font-headline text-base font-bold text-white transition hover:bg-white/12"
          href={REPO.url}
          target="_blank"
          rel="noreferrer"
        >
          <Star class="h-5 w-5 text-vega-accent" aria-hidden="true" />
          Star on GitHub
        </a>
      </div>
    </div>
    <div
      class="device-stage group relative mx-auto mt-2 flex w-full max-w-176 items-end sm:mt-3"
    >
      <div class="device-glow glow-portrait" aria-hidden="true"></div>
      <div class="device-glow glow-landscape" aria-hidden="true"></div>
      <div class="device-frame device-landscape absolute bottom-0 right-0 z-10 w-[90%] transition duration-500">
      <span class="device-camera" aria-hidden="true"></span>
      <Image
        class="device-screen"
        src={heroLandscape}
        width={1100}
        sizes="(min-width: 1024px) 42vw, 82vw"
        quality={80}
        alt="Vega video player in landscape"
        loading="lazy"
      />
      </div>

      <div class="device-frame device-portrait relative z-0 w-[38%] max-w-[240px] transition duration-500">
      <span class="device-camera" aria-hidden="true"></span>
      <Image
        class="device-screen"
        src={heroPortrait}
        width={520}
        sizes="(min-width: 1024px) 18vw, 38vw"
        quality={80}
        alt="Vega home screen in portrait"
        loading="lazy"
      />
      </div>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('.device-stage').forEach(stage => {
    stage.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse' || !matchMedia('(hover: hover)').matches) return;
      stage.dataset.motion = 'back';
    });
    stage.addEventListener('pointerleave', () => {
      if (stage.dataset.motion) stage.dataset.motion = 'front';
    });
  });
</script>

<style>
  .hero-section { background: #000; }
  .device-stage { isolation: isolate; }
  .device-glow {
    position: absolute;
    z-index: -2;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(36px);
  }
  .glow-portrait {
    width: 85%;
    height: 110%;
    left: -25%;
    top: -20%;
    background: radial-gradient(ellipse, rgb(137 44 28 / 40%), rgb(93 27 20 / 15%) 45%, transparent 72%);
  }
  .glow-landscape {
    width: 155%;
    height: 115%;
    right: -30%;
    bottom: -30%;
    background: radial-gradient(ellipse, rgb(56 145 190 / 72%), rgb(37 112 155 / 42%) 42%, transparent 74%);
  }
  .device-frame {
    border: 2px solid #5b5b60;
    border-radius: clamp(16px, 2.6vw, 32px);
    padding: clamp(4px, .55vw, 7px);
    background: #09090b;
    box-shadow: 0 0 0 1px #131316, inset 0 0 0 1px #b8b8c23b,
      0 24px 60px #0009, 0 4px 12px #0008;
    isolation: isolate;
    transition: transform 420ms cubic-bezier(.2,.8,.2,1), box-shadow 420ms ease;
  }
  @media (hover: hover) {
    .device-stage[data-motion='back'] .device-landscape {
      animation: landscape-to-back 800ms cubic-bezier(.4,0,.2,1) both;
    }
    .device-stage[data-motion='front'] .device-landscape {
      animation: landscape-to-front 800ms cubic-bezier(.4,0,.2,1) both;
    }
  }
  @keyframes landscape-to-back {
    0% { transform: translateX(0); z-index: 10; }
    49% { transform: translateX(30%); z-index: 10; }
    50% { transform: translateX(30%); z-index: -1; }
    100% { transform: translateX(0); z-index: -1; }
  }
  @keyframes landscape-to-front {
    0% { transform: translateX(0); z-index: -1; }
    49% { transform: translateX(30%); z-index: -1; }
    50% { transform: translateX(30%); z-index: 10; }
    100% { transform: translateX(0); z-index: 10; }
  }
  @media (prefers-reduced-motion: reduce) {
    .device-frame { transition: none; }
    .device-stage[data-motion] .device-landscape { animation: none; }
    .device-stage[data-motion='back'] .device-landscape { z-index: -1; }
    .device-stage[data-motion='front'] .device-landscape { z-index: 10; }
  }
  .device-screen {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(10px, 2vw, 23px);
  }
  .device-camera {
    position: absolute;
    z-index: 1;
    width: clamp(4px, .6vw, 7px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #182536, #030305 65%);
    box-shadow: 0 0 0 2px #09090b;
  }
  .device-portrait .device-camera { top: 2.5%; left: 50%; transform: translateX(-50%); }
  .device-landscape .device-camera { left: 2%; top: 50%; transform: translateY(-50%); }
  .device-frame::before,
  .device-frame::after {
    content: '';
    position: absolute;
    background: linear-gradient(90deg, #28282d, #85858c, #343439);
    border-radius: 2px;
  }
  .device-portrait::before { right: -4px; top: 21%; width: 3px; height: 12%; }
  .device-portrait::after { right: -4px; top: 38%; width: 3px; height: 7%; }
  .device-landscape::before { top: -4px; left: 21%; height: 3px; width: 12%; }
  .device-landscape::after { top: -4px; left: 38%; height: 3px; width: 7%; }
</style>
