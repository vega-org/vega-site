---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/sections/HeaderNav.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
---

<BaseLayout
  title="Privacy Policy | Vega"
  description="Vega does not collect, store, or share personal data. Crash reporting is handled through Firebase Crashlytics."
>
  <HeaderNav server:defer>
    <nav
      slot="fallback"
      class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-vega-bg/70 backdrop-blur-xl"
      aria-label="Primary"
    >
      <div
        class="mx-auto flex min-h-16 w-[min(1400px,calc(100%-1rem))] items-center justify-between gap-3 md:min-h-18 md:w-[min(1400px,calc(100%-3rem))] md:gap-4"
      >
        <div class="flex items-center gap-2">
          <div class="vega-skeleton h-8 w-8 rounded-md"></div>
          <div class="vega-skeleton h-8 w-24 rounded-md"></div>
        </div>
      </div>
    </nav>
  </HeaderNav>

  <main class="px-4 pt-28 pb-24 md:px-6">
    <div class="mx-auto w-full max-w-3xl">
      <h1
        class="font-headline text-[clamp(2rem,4vw,3.2rem)] font-black tracking-tight text-white"
      >
        Privacy Policy
      </h1>
      <p class="mt-2 text-sm text-vega-muted">Last updated: July 10, 2026</p>

      <div class="mt-10 space-y-10 text-vega-muted leading-relaxed">
        <section>
          <h2 class="font-headline text-xl font-bold text-white">
            1. Data Collection
          </h2>
          <p class="mt-3">
            Vega does not collect, store, or share any personal data. The app
            operates entirely on your device and does not require account
            creation. Your media sources, viewing history, and preferences
            remain local to your device.
          </p>
        </section>

        <section>
          <h2 class="font-headline text-xl font-bold text-white">
            2. Crash Reporting
          </h2>
          <p class="mt-3">
            Vega uses Crashlytics to collect crash and stability data when the
            app encounters an unexpected failure. This helps us identify and fix
            bugs and can be turned off from settings. Crashlytics may collect:
          </p>
        </section>

        <section>
          <h2 class="font-headline text-xl font-bold text-white">
            3. Third-Party Services
          </h2>
          <p class="mt-3">
            Vega integrates media sources that you choose to add. When you add a
            provider or source, your device communicates directly with that
            service. Vega does not proxy, log, or monitor those connections.
            Please review the privacy policies of any third-party sources you
            choose to use.
          </p>
        </section>

        <section>
          <h2 class="font-headline text-xl font-bold text-white">
            4. Changes to This Policy
          </h2>
          <p class="mt-3">
            We may update this privacy policy from time to time. Changes will be
            posted on this page with an updated date. Continued use of Vega
            after changes constitutes acceptance of the updated policy.
          </p>
        </section>

        <section>
          <h2 class="font-headline text-xl font-bold text-white">5. Contact</h2>
          <p class="mt-3">
            For privacy-related inquiries, open an issue on our
            {" "}
            <a
              class="text-vega-accent underline underline-offset-2 transition hover:text-vega-accent-strong"
              href="https://github.com/vega-org"
              target="_blank"
              rel="noreferrer"
            >
              GitHub organization
            </a>
            {" "}
            or reach out on
            {" "}
            <a
              class="text-vega-accent underline underline-offset-2 transition hover:text-vega-accent-strong"
              href="https://discord.com/invite/cr42m6maWy"
              target="_blank"
              rel="noreferrer"
            >
              Discord
            </a>.
          </p>
        </section>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  p {
    max-width: 68ch;
  }
</style>
