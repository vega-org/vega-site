{
  "compatibility_date": "2026-04-03",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "name": "vega-site",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VEGA_CAST_SESSIONS",
        "class_name": "CastSession"
      },
      {
        "name": "VEGA_CAST_DIRECTORY",
        "class_name": "CastDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "vega-cast-v1",
      "new_sqlite_classes": [
        "CastSession",
        "CastDirectory"
      ]
    }
  ]
}
